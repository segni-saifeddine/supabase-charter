# Copy to .env and adjust. Non-secret settings only.
#
# The one secret this file holds is DB_AGENT_MCP_TOKEN, the bearer token for
# the local MCP endpoint. The Supabase management token never appears here: the
# agent reads it from Vault at DB_AGENT_SUPABASE_TOKEN_VAULT_PATH.
#
# Every setting below has a default, so an empty .env starts a working server
# against a local Vault. The defaults are shown as the assigned values.

# --- Vault -------------------------------------------------------------------
# How to reach Vault. The agent shells out to the `vault` CLI, so it uses
# whatever credentials you are already logged in with (VAULT_TOKEN, or a
# `vault login` session). It never stores a Vault token itself.
VAULT_ADDR=http://127.0.0.1:8200

# The one path holding the Supabase management token and the organization slug.
# This is the agent's identity: it authenticates to Supabase with nothing else.
# Create it once, for example:
#   vault kv put secret/supabase ACCESS_TOKEN=sbp_... ORG_SLUG=your-org
DB_AGENT_SUPABASE_TOKEN_VAULT_PATH=secret/supabase

# Which keys in that secret hold the token and the slug. Leave empty to accept
# the usual names (ACCESS_TOKEN / SUPABASE_ACCESS_TOKEN / TOKEN and
# ORG_SLUG / ORGANIZATION_SLUG / SLUG), case-insensitively.
DB_AGENT_TOKEN_KEY=
DB_AGENT_ORG_SLUG_KEY=

# environment -> Vault KV v2 mount that the credentials of a database in that
# environment are written to. Separate mounts are what stop a dev database
# from landing next to production secrets, and let you give each mount its own
# Vault policy. Point them all at one mount if you do not want that split.
DB_AGENT_VAULT_MOUNTS=dev=dev,staging=staging,prod=prod

# Default folder under the mount, so a secret ends up at
# <mount>/<secret_path>/<project name>. May be nested (teams/acme). Leave it
# empty to require the folder per database instead.
DB_AGENT_SECRET_PATH=

# --- What the agent may create -----------------------------------------------
# Kinds of database the agent accepts. The kind becomes the project name prefix
# and is part of the ownership check: the agent refuses to act on a live
# project whose name does not start with one of these.
DB_AGENT_KINDS=dev,staging,demo,prod,poc,test

# Kinds that get no expiry by default, because they are meant to stay. Any
# other kind gets DB_AGENT_DEFAULT_TTL_DAYS. Both are only defaults; the
# requester can always ask for an explicit duration or for no expiry.
DB_AGENT_PERMANENT_KINDS=prod,staging
DB_AGENT_DEFAULT_TTL_DAYS=7

DB_AGENT_DEFAULT_ENVIRONMENT=dev
DB_AGENT_DEFAULT_REGION=us-east-1

# Supabase organization plan, used for the cost quote the agent must get
# approved before it creates anything (free, pro, team, enterprise). There is
# no pricing endpoint in the Management API, so this is read from here.
DB_AGENT_ORG_PLAN=free

# Project refs the agent must never touch, whatever the ledger says.
# Comma-separated. Put your real production refs here.
DB_AGENT_PROTECTED_REFS=

# --- Copying data from an existing database ----------------------------------
# Optional name shortcuts for source databases, so they can be named in chat.
# Any Vault path (<mount>/<folder>/<secret>) also works without being listed.
# Example:
#   DB_AGENT_SOURCES=analytics=prod/analytics/primary-db
DB_AGENT_SOURCES=

# Vault mounts a copy source may be read from. The first one is the default
# mount for list_sources. Sources are opened read-only.
DB_AGENT_SOURCE_MOUNTS=dev,staging,prod

# pg_dump must match the source server's major version (Supabase runs
# PostgreSQL 17). Set these only if the right binaries are not on PATH;
# psql defaults to the one sitting next to pg_dump.
# DB_AGENT_PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
# DB_AGENT_PSQL=/usr/lib/postgresql/17/bin/psql

# --- Ledger (state/databases.yaml) -------------------------------------------
# manual: the server writes the file in your checkout and you commit it.
# auto:   the server edits the ledger in a dedicated git worktree (never your
#         branch), one commit per change on a charter/* branch;
#         publish_ledger pushes it and opens a PR against the base branch.
DB_AGENT_STATE_GIT_SYNC=manual
DB_AGENT_LEDGER_BASE_BRANCH=main
# DB_AGENT_LEDGER_REMOTE=origin
# DB_AGENT_LEDGER_WORKTREE=.ledger-worktree
# DB_AGENT_STATE_PATH=state/databases.yaml

# --- Local MCP server --------------------------------------------------------
# Generate the token with: openssl rand -hex 24
# and put the same value in your MCP client config (Authorization: Bearer ...).
DB_AGENT_HOST=127.0.0.1
DB_AGENT_PORT=8766
DB_AGENT_MCP_TOKEN=
